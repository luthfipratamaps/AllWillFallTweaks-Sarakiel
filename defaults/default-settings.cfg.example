# Reference for newly generated settings (not automatically installed)
# The plugin creates the real config using BepInEx Config.Bind.
[Capacity]
StorageMultiplier = 10
HousingMultiplier = 5
WaterStorage = true
FoodWarehouse = true
FuelWarehouse = true
GeneralWarehouse = true
Housing = true

[Input]
BlockWorldMouseWhileMenuOpen = true
BlockNewInputSystemWhileMenuOpen = true

[Resources]
DefaultAmount = 100

[Startup]
AutoScanOnCityLoad = true
BackgroundScanIntervalSeconds = 5

[UI]
WindowX = 110
WindowY = 90
ToggleKey = F8

[Diagnostics]
VerboseLogging = false
